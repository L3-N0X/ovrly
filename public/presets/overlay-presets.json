            "flexDirection": "row",
            "gap": 24,
            "alignItems": "center",
            "x": 48,
            "y": 48
          },
          "children": [
            {
              "name": "Label",
              "type": "TITLE",
              "style": {
                "fontFamily": "Roboto",
                "fontSize": 72
              },
              "title": {
                "text": "Followers"
              }
            },
            {
              "name": "Followers",
              "type": "TWITCH_STAT",
              "style": {
                "fontFamily": "Roboto Mono",
