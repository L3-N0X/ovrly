                      "style": { "fontSize": 20, "color": "#ffffffb3" },
                      "title": { "text": "Sub +5 min" }
                    },
                    {
                      "name": "Tier 2",
                      "type": "TITLE",
                      "style": { "fontSize": 20, "color": "#ffffffb3" },
                      "title": { "text": "Tier 2 +10 min" }
                    },
                    {
                      "name": "Tier 3",
                      "type": "TITLE",
                      "style": { "fontSize": 20, "color": "#ffffffb3" },
                      "title": { "text": "Tier 3 +25 min" }
                    },
                    {
                      "name": "Bits",
                      "type": "TITLE",
                      "style": { "fontSize": 20, "color": "#ffffffb3" },
                      "title": { "text": "100 bits +1 min" }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "scoreboard",
      "name": "Scoreboard",
