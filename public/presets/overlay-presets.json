          ]
        }
      ]
    },
    {
      "id": "bingo",
      "name": "Bingo",
      "description": "A bingo card with a title. Fill in the fields and mark them live.",
      "width": 1920,
      "height": 1080,
      "canvasMode": "FREE",
      "globalStyle": {},
      "elements": [
        {
          "name": "Bingo column",
          "type": "CONTAINER",
          "style": {
            "flexDirection": "column",
            "gap": 20,
            "alignItems": "flex-start",
            "x": 48,
            "y": 48
          },
          "children": [
            {
              "name": "Title",
              "type": "TITLE",
              "style": {
                "fontFamily": "Roboto",
                "fontSize": 56
              },
              "title": {
                "text": "Stream Bingo"
              }
            },
            {
              "name": "Bingo card",
              "type": "BINGO",
              "style": {
                "width": 520,
                "height": 520,
                "fontSize": 40,
                "gridLines": true,
                "padding": 0
              },
              "bingo": {
                "rows": 5,
                "columns": 5,
                "freeMiddle": true,
                "fields": [
                  "Chat says W",
                  "First death",
                  "Technical difficulties",
                  "Talking while muted",
                  "Raid incoming",
                  "New sub",
                  "Backseating in chat",
                  "Rage moment",
                  "Forgot to drink",
                  "Lag spike",
                  "Pet cameo",
                  "Emote spam",
                  "",
                  "“One more game”",
                  "Hype train",
                  "Gifted subs",
                  "“Clip it!”",
                  "Snack break",
                  "Wrong scene",
                  "“I meant to do that”",
                  "Fall damage",
                  "New follower",
                  "Song request",
                  "Chat was right",
                  "Lost track of time"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "scoreboard",
