{
  "presets": [
    {
      "id": "timer",
      "name": "Timer",
      "description": "A stopwatch that counts up. You start and pause it while live.",
      "width": 1920,
      "height": 1080,
      "canvasMode": "FREE",
      "globalStyle": {},
      "elements": [
        {
          "name": "Timer",
          "type": "TIMER",
          "style": {
            "fontFamily": "Roboto Mono",
            "fontSize": 96,
            "backgroundColor": "#000000b3",
            "padding": 24,
            "radius": 20,
            "x": 48,
            "y": 48
          }
        }
      ]
    },
    {
      "id": "countdown",
      "name": "Countdown",
      "description": "A “Starting soon” screen counting down to your stream, or from a few minutes.",
      "width": 1920,
      "height": 1080,
      "canvasMode": "FREE",
      "globalStyle": {},
      "elements": [
        {
          "name": "Countdown column",
          "type": "CONTAINER",
          "style": {
            "flexDirection": "column",
            "gap": 16,
            "alignItems": "center",
            "x": 660,
            "y": 380
          },
          "children": [
            {
              "name": "Label",
              "type": "TITLE",
              "style": {
                "fontFamily": "Roboto",
                "fontSize": 64
              },
              "title": {
                "text": "Starting soon"
              }
            },
            {
              "name": "Countdown",
              "type": "COUNTDOWN",
              "style": {
                "fontFamily": "Roboto Mono",
                "fontSize": 128,
                "backgroundColor": "#000000b3",
                "padding": 24,
                "radius": 20,
                "format": "mm:ss"
              },
              "countdown": {
                "mode": "DURATION",
                "duration": 300000
              }
            }
          ]
        }
      ]
    },
    {
      "id": "counter",
      "name": "Counter",
      "description": "One labeled number, like deaths or wins, that you count live.",
      "width": 1920,
      "height": 1080,
      "canvasMode": "FREE",
      "globalStyle": {},
      "elements": [
        {
          "name": "Counter row",
          "type": "CONTAINER",
          "style": {
            "flexDirection": "row",
            "gap": 24,
            "alignItems": "center",
            "x": 48,
            "y": 48
          },
          "children": [
            {
              "name": "Label",
              "type": "TITLE",
              "style": {
                "fontFamily": "Roboto",
                "fontSize": 72
              },
              "title": {
                "text": "Deaths"
              }
            },
            {
              "name": "Counter",
              "type": "COUNTER",
              "style": {
                "fontFamily": "Roboto Mono",
                "fontSize": 72,
                "backgroundColor": "#ffffff26",
                "padding": 20,
                "radius": 16
              },
              "counter": {
                "value": 0
              }
            }
          ]
        }
      ]
    },
    {
      "id": "twitch-followers",
      "name": "Followers",
      "description": "The follower count of a Twitch channel, updated live while you stream.",
      "width": 1920,
      "height": 1080,
      "canvasMode": "FREE",
      "globalStyle": {},
      "elements": [
        {
          "name": "Followers row",
          "type": "CONTAINER",
