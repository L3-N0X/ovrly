      ]
    },
    {
      "id": "bingo",
      "name": "Stream bingo",
      "description": "A bingo card in the top right corner for chat to follow along. Fill in the fields and mark them live.",
      "width": 1920,
      "height": 1080,
      "canvasMode": "FREE",
      "globalStyle": {},
      "elements": [
        {
          "name": "Top right",
          "type": "CONTAINER",
          "style": {
            "x": 0,
            "y": 0,
            "fillWidth": true,
            "autoHeight": true,
            "flexDirection": "column",
            "alignItems": "flex-end",
            "gap": 16,
            "paddingX": 48,
            "paddingY": 48
          },
          "children": [
            {
              "name": "Bingo card",
              "type": "CONTAINER",
              "style": {
                "autoWidth": true,
