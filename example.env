POSTGRES_USER="user"
POSTGRES_PASSWORD="password"

APP_BASE_URL="http://localhost:3000"

OVRLY_AUTH_SECRET="supersecretkeythatshouldbechanged"
OVRLY_TWITCH_CLIENT_ID="your_twitch_client_id"
OVRLY_TWITCH_CLIENT_SECRET="your_twitch_client_secret"
# OAuth Redirect URLs of the Twitch app: <APP_BASE_URL>/api/auth/callback/twitch (sign-in) and
# <APP_BASE_URL>/api/twitch/callback (connecting channels for subscriber stats).

# Credentials for the bundled S3 storage (RustFS) used for image uploads. Change them!
OVRLY_S3_ACCESS_KEY="ovrly"
OVRLY_S3_SECRET_KEY="change-me-please"
OVRLY_S3_BUCKET="ovrly"

# If you want to build the frontend with Vite, set your Google Fonts API key here
VITE_GOOGLE_FONTS_API_KEY="your_google_fonts_api_key"
# Local only: enables email/password sign-in for the CLAUDE.md test user. Leave unset in production.
# AUTH_EMAIL_PASSWORD="true"
