generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String          @id @default(cuid())
  name                  String
  email                 String          @unique
  emailVerified         Boolean         @default(false)
  image                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  twoFactorEnabled      Boolean         @default(false)
  Session               Session[]
  Account               Account[]
  Overlay               Overlay[]
  Image                 Image[]
  // People this user gave access to all of their overlays.
  accountShares         AccountShare[]  @relation("AccountShareOwner")
  // Access other users gave this user, to all of their overlays or to single ones.
  accountSharesWithMe   AccountShare[]  @relation("AccountShareMember")
  overlaySharesWithMe   OverlayShare[]
  // Twitch channels this user connected, so their subscriber stats can be shown.
  twitchConnections     TwitchConnection[]
  // Keys for the public API (docs/public-api.md), and the variables sent with them.
  apiKeys               ApiKey[]
  variables             Variable[]
}

model Image {
  id        String   @id @default(cuid())
  url       String
  filename  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// What someone an overlay is shared with may do. Ordered from least to most access; the
// owner can always do everything, including sharing and deleting.
enum ShareRole {
  // Sees the overlay and its live state.
  VIEWER
  // Also runs it: counters, timers, countdowns, titles, images, icons, bingo cards and Twitch stats.
  CONTROLLER
  // Also changes its design: elements, layout and styles.
  EDITOR
}

// Access to every overlay of `owner`, including ones created later.
model AccountShare {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation("AccountShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Null until someone with this Twitch name signs in (linked in auth.ts).
  userId     String?
  user       User?     @relation("AccountShareMember", fields: [userId], references: [id], onDelete: Cascade)
  twitchName String
  role       ShareRole @default(EDITOR)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([ownerId, twitchName])
  @@index([userId])
  @@index([twitchName])
}

// How the elements that sit directly on the canvas are placed: laid out by the global
// arrangement (a flex row or column with gaps), or freely by dragging them.
enum CanvasMode {
  AUTO
  FREE
}

model Overlay {
  id          String          @id @default(cuid())
  name        String
  description String?
  globalStyle Json?
  // The size of the canvas as OBS renders it. Set per overlay, since a browser source is
  // sized to match.
  width       Int             @default(1920)
  height      Int             @default(1080)
  canvasMode  CanvasMode      @default(FREE)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  elements    Element[]
  shares      OverlayShare[]
  // Bumped every time the overlay's state is broadcast. Clients use it to tell an older
  // snapshot (a slow fetch, an out-of-order broadcast) from a newer one.
  revision    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}

// Access to a single overlay. Someone with an account share as well gets the higher role.
model OverlayShare {
  id         String    @id @default(cuid())
  overlayId  String
  overlay    Overlay   @relation(fields: [overlayId], references: [id], onDelete: Cascade)
  // Null until someone with this Twitch name signs in (linked in auth.ts).
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twitchName String
  role       ShareRole @default(EDITOR)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([overlayId, twitchName])
  @@index([userId])
  @@index([twitchName])
}

model Element {
  id        String      @id @default(cuid())
  overlayId String
  overlay   Overlay     @relation(fields: [overlayId], references: [id], onDelete: Cascade)
  type      ElementType
  name      String
  style     Json?
  position  Int?

  // Relations for specific element types
  title     Title?
  counter   Counter?
  timer     Timer?
  countdown Countdown?
  image     ImageElement?
  bingo     Bingo?
  twitchStat TwitchStat?
  variable  VariableBinding?
  icon      Icon?

  // Self-relation for grouping
  parentId  String?
  parent    Element?    @relation("ElementChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Element[]   @relation("ElementChildren")

  @@index([overlayId, position])
  @@index([parentId])
}

enum ElementType {
  TITLE
  COUNTER
  TIMER
  CONTAINER
  IMAGE
  GROUP
  BINGO
  COUNTDOWN
  TWITCH_STAT
  VARIABLE
  ICON
}

model Title {
  id        String  @id @default(cuid())
  text      String
  elementId String  @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

model Counter {
  id        String  @id @default(cuid())
  value     Int     @default(0)
  elementId String  @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

// Counts up. Counting down is what a Countdown is for.
model Timer {
  id        String    @id @default(cuid())
  startedAt DateTime?
  pausedAt  DateTime?
  elementId String    @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

enum CountdownMode {
  // Counts down a length of time; it is started, paused and reset like a timer.
  DURATION
  // Counts down to a point in time, and always runs.
  TARGET
}

model Countdown {
  id        String        @id @default(cuid())
  mode      CountdownMode @default(DURATION)
  // The length of time it starts from and resets to, in milliseconds.
  duration  Int           @default(300000)
  // The time left while it is paused, in milliseconds.
  remaining Int           @default(300000)
  // When it reaches zero while it is running. Null while paused.
  endsAt    DateTime?
  // When it reaches zero in TARGET mode.
  targetAt  DateTime?
  elementId String        @unique
  element   Element       @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

model ImageElement {
  id        String  @id @default(cuid())
  src       String
  elementId String  @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

// An icon from one of the icon libraries bundled with the editor (src/lib/icons.ts). It is
// stored by library and name, so the drawing itself always comes from the library.
model Icon {
  id        String  @id @default(cuid())
  // One of the ids in lib/icons.ts.
  library   String  @default("lucide")
  // The icon's name within the library ("star", "heart-bold"), as the library spells it.
  name      String  @default("star")
  elementId String  @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

model Bingo {
  id         String  @id @default(cuid())
  rows       Int     @default(5)
  columns    Int     @default(5)
  freeMiddle Boolean @default(false)
  fields     Json
  checked    Json
  elementId  String  @unique
  element    Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

enum TwitchStatType {
  FOLLOWERS
  // Viewers of the current stream; 0 while the channel is offline.
  VIEWERS
  // These two are private to the channel: it has to be connected (TwitchConnection).
  SUBSCRIBERS
  SUB_POINTS
}

enum TwitchStatStatus {
  // No channel picked yet, or not fetched since it was picked.
  PENDING
  OK
  // A subscriber stat of a channel nobody connected to ovrly.
  NOT_CONNECTED
  // A subscriber stat of a connected channel, in an overlay its owner may not use it in.
  NOT_ALLOWED
}

// A number from a Twitch channel, kept up to date by services/twitch-stats.ts while the overlay
// is open somewhere. The channel can be any channel, not just the overlay owner's.
model TwitchStat {
  id          String           @id @default(cuid())
  stat        TwitchStatType   @default(FOLLOWERS)
  // The channel's login name, lowercased. Empty until a channel is picked.
  channelLogin String          @default("")
  // Resolved from the login name when the channel is picked.
  channelId   String?
  channelName String?
  // The latest value, null until one was fetched (or while it can't be).
  value       Int?
  status      TwitchStatStatus @default(PENDING)
  fetchedAt   DateTime?
  elementId   String           @unique
  element     Element          @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

// A Twitch channel whose owner allowed ovrly to read its subscriptions. Kept apart from the
// sign-in Account, whose token better-auth replaces (without this scope) on every sign-in.
// Its subscriber stats may be shown in overlays of `user` and of the people on their team.
model TwitchConnection {
  id           String   @id @default(cuid())
  // Who connected it.
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twitchId     String   @unique
  login        String
  displayName  String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// A key other applications use to call the public API (routes/publicApi.ts) on behalf of
// `user`. Only a hash of it is stored; the key itself is shown once, when it is created.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // The start of the key, so it can be recognised in the settings.
  prefix     String
  // SHA-256 of the key, hex encoded.
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum VariableType {
  STRING
  INTEGER
  DOUBLE
  BOOLEAN
  // A "#rrggbb" or "#rrggbbaa" hex colour.
  COLOR
}

// A value another application keeps up to date on the account of `user` through the public
// API, such as the points of a team in a tournament. `source` names the application
// ("minecraft-tournament"), `key` the value within it ("red.points").
model Variable {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String
  key       String
  type      VariableType
  // A JSON string, number or boolean, matching `type`.
  value     Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, source, key])
}

// What a variable element shows: a Variable of the overlay owner's account. It is picked by
// source and key rather than by id, so it can be picked before the application first sent it
// and keeps working when the application deletes and sends it again. Its type and value are
// copied here whenever it changes (services/variables.ts), so they reach editors and OBS with
// the rest of the overlay.
model VariableBinding {
  id        String        @id @default(cuid())
  // Empty until a variable is picked.
  source    String        @default("")
  key       String        @default("")
  // Null while the owner has no such variable.
  type      VariableType?
  value     Json?
  updatedAt DateTime?
  elementId String        @unique
  element   Element       @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@index([source, key])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  @@index([userId])
  @@index([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}