generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Relations are loaded with LATERAL JOINs in a single query instead of one
  // query per relation. Inside a transaction every query shares one connection,
  // and pg deprecates sending several queries on it before the first is done.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String          @id @default(cuid())
  name                  String
  email                 String          @unique
  emailVerified         Boolean         @default(false)
  image                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  twoFactorEnabled      Boolean         @default(false)
  Session               Session[]
  Account               Account[]
  Overlay               Overlay[]
  Image                 Image[]
  // People this user gave access to all of their overlays.
  accountShares         AccountShare[]  @relation("AccountShareOwner")
  // Access other users gave this user, to all of their overlays or to single ones.
  accountSharesWithMe   AccountShare[]  @relation("AccountShareMember")
  overlaySharesWithMe   OverlayShare[]
  // Twitch channels this user connected, so their subscriber stats can be shown.
  twitchConnections     TwitchConnection[]
  // The Spotify account whose playback this user's overlays can show.
  spotifyConnection     SpotifyConnection?
  // Keys for the public API (docs/public-api.md), and the variables sent with them.
  apiKeys               ApiKey[]
  variables             Variable[]
  // Providers that keep variables of this user up to date, like a Twitch channel's stats.
  variableSources       VariableSource[]
  // Pieces of overlays this user saved or imported to add to any overlay.
  components            Component[]
}

model Image {
  id        String   @id @default(cuid())
  url       String
  filename  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// What someone an overlay is shared with may do. Ordered from least to most access; the
// owner can always do everything, including sharing and deleting.
enum ShareRole {
  // Sees the overlay and its live state.
  VIEWER
  // Also runs it: counters, timers, countdowns, titles, images, icons, bingo cards, and the
  // values of the owner's variables.
  CONTROLLER
  // Also changes its design: elements, layout and styles.
  EDITOR
}

// Access to every overlay of `owner`, including ones created later.
model AccountShare {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation("AccountShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // Null until someone with this Twitch name signs in (linked in auth.ts).
  userId     String?
  user       User?     @relation("AccountShareMember", fields: [userId], references: [id], onDelete: Cascade)
  twitchName String
  role       ShareRole @default(EDITOR)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([ownerId, twitchName])
  @@index([userId])
  @@index([twitchName])
}

// How the elements that sit directly on the canvas are placed: laid out by the global
// arrangement (a flex row or column with gaps), or freely by dragging them.
enum CanvasMode {
  AUTO
  FREE
}

model Overlay {
  id          String          @id @default(cuid())
  name        String
  description String?
  globalStyle Json?
  // The size of the canvas as OBS renders it. Set per overlay, since a browser source is
  // sized to match.
  width       Int             @default(1920)
  height      Int             @default(1080)
  canvasMode  CanvasMode      @default(FREE)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  elements    Element[]
  shares      OverlayShare[]
  // Bumped every time the overlay's state is broadcast. Clients use it to tell an older
  // snapshot (a slow fetch, an out-of-order broadcast) from a newer one.
  revision    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}

// Access to a single overlay. Someone with an account share as well gets the higher role.
// A reusable piece of an overlay: elements a user saved from one (or imported from a file) to
// add to any overlay later. A snapshot, copied on every insert; it never changes with the
// elements it came from, nor they with it.
model Component {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // The element tree, in the format of a component file (lib/components.ts).
  elements    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model OverlayShare {
  id         String    @id @default(cuid())
  overlayId  String
  overlay    Overlay   @relation(fields: [overlayId], references: [id], onDelete: Cascade)
  // Null until someone with this Twitch name signs in (linked in auth.ts).
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twitchName String
  role       ShareRole @default(EDITOR)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([overlayId, twitchName])
  @@index([userId])
  @@index([twitchName])
}

model Element {
  id        String      @id @default(cuid())
  overlayId String
  overlay   Overlay     @relation(fields: [overlayId], references: [id], onDelete: Cascade)
  type      ElementType
  name      String
  style     Json?
  position  Int?

  // Relations for specific element types
  title     Title?
  counter   Counter?
  timer     Timer?
  countdown Countdown?
  image     ImageElement?
  bingo     Bingo?
  icon      Icon?
  progress  Progress?
  subathon  Subathon?
  // Properties of the element driven by variables instead of their own value.
  bindings  VariableBinding[]

  // Self-relation for grouping
  parentId  String?
  parent    Element?    @relation("ElementChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Element[]   @relation("ElementChildren")

  @@index([overlayId, position])
  @@index([parentId])
}

enum ElementType {
  TITLE
  COUNTER
  TIMER
  CONTAINER
  IMAGE
  GROUP
  BINGO
  COUNTDOWN
  ICON
  RECTANGLE
  PROGRESS
  SUBATHON
  SCROLLER
}

model Title {
  id        String  @id @default(cuid())
  text      String
  elementId String  @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

model Counter {
  id        String  @id @default(cuid())
  value     Int     @default(0)
  elementId String  @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

// Counts up. Counting down is what a Countdown is for.
model Timer {
  id        String    @id @default(cuid())
  startedAt DateTime?
  pausedAt  DateTime?
  elementId String    @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

enum CountdownMode {
  // Counts down a length of time; it is started, paused and reset like a timer.
  DURATION
  // Counts down to a point in time, and always runs.
  TARGET
}

model Countdown {
  id        String        @id @default(cuid())
  mode      CountdownMode @default(DURATION)
  // The length of time it starts from and resets to, in milliseconds.
  duration  Int           @default(300000)
  // The time left while it is paused, in milliseconds.
  remaining Int           @default(300000)
  // When it reaches zero while it is running. Null while paused.
  endsAt    DateTime?
  // When it reaches zero in TARGET mode.
  targetAt  DateTime?
  elementId String        @unique
  element   Element       @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

model ImageElement {
  id        String  @id @default(cuid())
  src       String
  elementId String  @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

// An icon from one of the icon libraries bundled with the editor (src/lib/icons.ts). It is
// stored by library and name, so the drawing itself always comes from the library.
model Icon {
  id        String  @id @default(cuid())
  // One of the ids in lib/icons.ts.
  library   String  @default("lucide")
  // The icon's name within the library ("star", "heart-bold"), as the library spells it.
  name      String  @default("star")
  elementId String  @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

// A bar filled to `value` out of `max`: a song's progress, a donation goal. In percent mode (its
// style) `max` is ignored and `value` is a percentage.
model Progress {
  id        String  @id @default(cuid())
  value     Float   @default(50)
  max       Float   @default(100)
  // Moves the bar on by one per second between updates, for values in seconds that a provider
  // only sends every few seconds (a Spotify track's progress, bound to whether it is playing).
  running   Boolean @default(false)
  elementId String  @unique
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

// A countdown that Twitch subs and cheers of a channel add time to (lib/subathon.ts). Times are
// milliseconds, stored as doubles because a subathon can run for longer than an Int holds.
model Subathon {
  id               String    @id @default(cuid())
  // The length of time it starts from and resets to.
  duration         Float     @default(3600000)
  // The time left while it is paused.
  remaining        Float     @default(3600000)
  // When it reaches zero while it is running. Null while paused.
  endsAt           DateTime?
  // The Twitch channel (id) whose events add time. Null means the owner's own channel, the one
  // they sign in with. Either way it has to be connected (TwitchConnection) for the owner's team.
  channelId        String?
  // Time added per sub (new, resub shared in chat, or gifted) of each tier. Prime counts as tier 1.
  tier1Ms          Int       @default(300000)
  tier2Ms          Int       @default(600000)
  tier3Ms          Int       @default(1500000)
  // Time added per 100 bits cheered, in proportion for any other amount.
  bitsMs           Int       @default(60000)
  // Multiplies what events add, for a happy hour.
  multiplier       Float     @default(1)
  // The most time left that events can add up to. Null for no limit.
  maxRemaining     Float?
  // Whether events add time while it is paused, e.g. before the stream starts.
  countWhilePaused Boolean   @default(true)
  // Totals since the last reset.
  subs             Int       @default(0)
  bits             Int       @default(0)
  addedMs          Float     @default(0)
  // The latest time an event added, so overlays can show it ("+5m") for a moment.
  lastAddedMs      Float     @default(0)
  lastAddedAt      DateTime?
  elementId        String    @unique
  element          Element   @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model Bingo {
  id         String  @id @default(cuid())
  rows       Int     @default(5)
  columns    Int     @default(5)
  freeMiddle Boolean @default(false)
  fields     Json
  checked    Json
  elementId  String  @unique
  element    Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
}

// A Twitch channel whose owner allowed ovrly to read its subscriptions. Kept apart from the
// sign-in Account, whose token better-auth replaces (without this scope) on every sign-in.
// Its subscriber stats may be shown in overlays of `user` and of the people on their team.
model TwitchConnection {
  id           String   @id @default(cuid())
  // Who connected it.
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twitchId     String   @unique
  login        String
  displayName  String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// The Spotify account of `user`, whose playback (track, artist, cover, progress) becomes the
// variables of their "spotify:player" source (services/spotify-variables.ts). One per user.
model SpotifyConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotifyId    String
  displayName  String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([spotifyId])
}

// A key other applications use to call the public API (routes/publicApi.ts) on behalf of
// `user`. Only a hash of it is stored; the key itself is shown once, when it is created.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // The start of the key, so it can be recognised in the settings.
  prefix     String
  // SHA-256 of the key, hex encoded.
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum VariableType {
  STRING
  INTEGER
  DOUBLE
  BOOLEAN
  // A "#rrggbb" or "#rrggbbaa" hex colour.
  COLOR
  // The URL of an image: http(s), or an upload of this server ("/uploads/...").
  IMAGE
}

// A named value of `user` that elements of their overlays can be bound to (VariableBinding):
// a team's points, a colour, a Twitch channel's follower count. `source` groups it ("scores",
// "twitch:shroud"), `key` names it within that group ("red.points"). Variables are created by
// the user in the editor, by applications through the public API (routes/publicApi.ts), or by
// a provider (VariableSource), whose sources contain a ":" so that nothing else can write them.
model Variable {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String
  key       String
  type      VariableType
  // A JSON string, number or boolean, matching `type`.
  value     Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, source, key])
}

enum VariableProvider {
  TWITCH
  SPOTIFY
}

// Something outside ovrly that keeps a set of variables of `user` up to date while one of
// their overlays is open, like the stats of a Twitch channel (services/twitch-variables.ts).
// Its variables are named `<name>/<key>`; deleting it deletes them.
model VariableSource {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   VariableProvider
  // The source its variables carry, "<provider>:<name>" ("twitch:shroud").
  name       String
  // What the provider knows it by: the channel id for Twitch, the account id for Spotify.
  externalId String
  // Provider settings, e.g. the channel's display name.
  config     Json
  // Why some of its variables are missing, e.g. "NOT_CONNECTED" for the subscriber stats of a
  // Twitch channel nobody connected. Null when everything could be read.
  problem    String?
  createdAt  DateTime         @default(now())

  @@unique([userId, name])
  @@index([externalId])
}

// One property of an element that shows a variable of the overlay owner instead of its own
// value: a title's text, a counter's value, a colour or size in its style. The variable is
// named by source and key rather than referenced by id, so a binding keeps working when an
// application deletes and sends its variables again, and copies of the overlay (also into other
// accounts) pick up the variable of the same name of their new owner.
model VariableBinding {
  id        String  @id @default(cuid())
  elementId String
  element   Element @relation(fields: [elementId], references: [id], onDelete: Cascade)
  // "text", "value", "src", or "style.<key>" (lib/bindings.ts lists them per element type).
  property  String
  source    String
  key       String

  @@unique([elementId, property])
  @@index([source, key])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  @@index([userId])
  @@index([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}